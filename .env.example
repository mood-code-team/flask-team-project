SECRET_KEY=your-secret-key-here

# SQLite (로컬 개발)
DATABASE_URL=sqlite:///database/shop.db

# MySQL (팀 공유) — 주석 해제 후 사용
# DATABASE_URL=mysql+pymysql://moodcode:password@localhost:3306/moodcode_shop

FLASK_ENV=development
TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWYo0z18Jql8VoXDL

# 채널톡 (선택)
CHANNEL_TALK_PLUGIN_KEY=
CHANNEL_TALK_SECRET=

# 카카오 로그인 — https://developers.kakao.com
# 소셜 로그인 데모 (로컬·과제용) — true: 버튼 클릭만으로 로그인, false: 실제 OAuth
SOCIAL_DEMO_LOGIN=true

# Redirect URI: http://127.0.0.1:5000/auth/kakao/callback (카카오 콘솔에도 동일하게 등록)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:5000/auth/kakao/callback

# Apple 로그인 — Apple Developer Service ID / Sign in with Apple Key
# Redirect URI: https://your-domain/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
